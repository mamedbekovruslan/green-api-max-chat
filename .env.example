# Используется только локальными скриптами разработки (проверки через curl, живые тесты).
# Префикс VITE_ не используется намеренно: эти значения не должны попасть в клиентскую сборку.
# Скопируйте в .env.local и заполните. .env.local не попадает в git.
GREEN_API_URL=https://1234.api.green-api.com
GREEN_API_ID_INSTANCE=1234567890
GREEN_API_TOKEN=
# Номер контакта в MAX, который ответит во время живых тестов (только цифры)
TEST_RECIPIENT_PHONE=
